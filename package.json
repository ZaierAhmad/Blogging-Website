{
  "name": "blogging-website",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "parcel src/index.html",
    "lint:html": "htmlhint src/**/*.html", // Lint HTML files in src
    "lint:css": "stylelint styles/**/*.css", // Lint CSS files in styles
    "lint": "npm run lint:html && npm run lint:css",
    "build": "parcel build src/**/*.html styles/**/*.css --out-dir public --public-url /Blogging-Website/ --no-cache"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "htmlhint": "^1.6.3",
    "parcel": "^2.15.4",
    "stylelint": "^16.21.0",
    "stylelint-config-standard": "^38.0.0"
  }
}
